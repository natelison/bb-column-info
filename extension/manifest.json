{
  "manifest_version": 3,
  "name": "Blackboard Ultra Gradebook Column Info",
  "short_name": "Bb Column Info",
  "version": "1.0.1",
  "description": "Hover a column header in the Blackboard Learn Ultra gradebook to see its settings: points, category, schema, due date and more.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Bb Column Info",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*"]
}
