{
  "manifest_version": 3,
  "name": "Blackboard Ultra Gradebook Column Info",
  "short_name": "Bb Column Info",
  "version": "1.1.0",
  "description": "Adds points possible back to the Blackboard Learn Ultra gradebook grid, and shows column settings when you hover a column header.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Bb Column Info",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
